 "poems": [
  {
   "seq": "1",
   "text": "いまそしるおもひのはてに世中のうき雲にのみましる物とは",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "ゆく人も天のとわたる心ちして雲の浪ちに月をみるかな",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "ひとかたになひく藻鹽の煙かなつれなき人のかゝらましかは",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "けさよりは春たちぬとや久方のそらさへ更にのとけかるらん",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "朝な〓〓山の木のめのかすむより春の綠そあらたまり行",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "玉つさはところたかへもある物をかならす北にかへる馬かね",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "あけて見ぬたか張章もいたつらにまたよをこめて歸る高かね",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "うくひすの聲きくなへに改玉の年も春へとかすむ空哉",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "春の田はいねてふこともなき物をいそくや何そかへる膓かね",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "春きてもなをうら寒き朝氷なみたさなから鶯そなく",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "雲よりもよそになり行葛城のたかまの根嵐ふくらし",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "またさかぬ軒はの梅にうくひすの木つたひららす春の淡雪",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "きても見ぬふるさと人のをそ櫻ちりのこれりと猶やつけまし",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "春はまつとふひのゝへに打むれてゆくや誰そもわかな摘也",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "みよし野の水わけ山のたに〓〓のせゝにわかれてちる櫻かな",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "山さくらさきちる時の春をへてよはひは花のかけにふりにき",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "春の野に我身ふりぬる袖なれはつめと若菜の名こそたまらね",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "暮て行そらをやよひのしはしともはるの別はいふかひもなし",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "しもけたぬいまたむ月の空さへていつらはよはの月朧なる",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "あやしともえやかきそへん玉章のもしならひしてかへる鴈金",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "卯花の咲ぬと人につけやらはこてふにゝたり月にまかへて",
   "kana": "",
   "speaker": "",
   "page": 136,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "ゆくさきのみちもおほえぬさ月やみ位の山にみはまよひつゝ",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "しのゝめのしからき山の郭公ひはらかうへの雲になく也",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "千早振神のみむろのみとしろにみな月かけて早苗とる也",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "ほとゝきす今一こゑの後にこそきゝさためても人にかたらめ",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "くさのはにかけをとゝめて飛螢露やおもひのかすにもゆ覽",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "いつまてか聲をしのひし郭公五月となれはよたゝ鳴え",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "ひろふてふ玉にもかもな楸生るきよきかはらに螢とふなり",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "五月雨のみかさかたよせ河へなるつゝみのうちに早苗とるえ",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "かちわたりやすのかはよと行駒に波もせこしの五月雨の比",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "ともしひのあかしの浦のあた浪のよるの螢はあともさためす",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "五月雨によとのかはせのつなはてを猶引はえてのほる舟人",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "をのつからの中のし水知人もわするはかりにしける夏草",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "さす棹に水のみかさのたかせ舟はやくそくたす五月雨の比",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "むろの浦のせとの早舟浪たてゝかたほにかくる風の涼しさ",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "水の音は深きにしもそよはるなる井せきをこゆる五月雨の比",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "風かよふのもりかやとのさゝむしろ木陰なられと夕涼みせり",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "夕附日木すゑをそむる立田山またき無名の秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "山河のさゝれもふちとかはるまて瀨をせくものは五月雨の比",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "五月雨のころそつねなる飛鳥川きのふの淵のかはる瀨もなし",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "よる波のすゝしくもあるか敷妙のそてしの浦の秋の初風",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "秋といはゝなをもいそかて七夕の何か七日の暮をまつらん",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "山もとのむかひのわさた見渡せは稻葉色つき秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "屬啼て夕霧たちぬ山本のわさたを寒み秋やきぬらし",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "天河うきつの御舟小夜更てわたるかちをとはやいそくえ",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "物をのみさも思はするさきのよのむくゐや秋の夕なるらん",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "なをきりの音たにつらき荻の葉に夕をわきて秋風モ吹",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "なく涙露にそはれるわたくしの老のよかなし秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "かくれかとたのむすみかのしの薄ほになまねきそ人も社とへ",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "秋かせにそらも夕の悲しきを草のはにのみ虫の鳴らん",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "まねけとてうへし薄の一村にとはれぬ庭そしけりはてぬる",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "さひしさは月にそみゆるみかの原くにの都の秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "秋の野の尾花にましる鹿のねの色にや妻を戀わたるらん",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "まとあけて山のは見ゆる闇の中に枕そはたて月を待哉",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "夕くれはふきもさためぬ秋風にまねく尾花の袖かへる見ゆ",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "くるゝよの嵐は何を拂ふらんかねて雲なき山端の月",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "いかなれはをのか盛をつねよりもひきあけて咲藤袴哉",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "暮やらてまたかたあかきそらの色やかて出そふ月のかけかな",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "秋かなのきけるさひしし高砂の尾上の鹿ばなかすもあらなん",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "何をしていたつらなりと思はぬは月みるあきのわか心かも",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "わかととの板井をかくる小山田にさとゝをしとや鹿の鳴らん",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "名にしおふさかひやいつら明石瀉うら波遠くすめる月かな",
   "kana": "",
   "speaker": "",
   "page": 137,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "淺茅生のしけみの庭の秋風に露を哀と月にみるかな",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "うつまゝに衣やうすくなりぬらんきぬたにちかきつちの音哉",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "老と成つらさはしりぬしかりとてそむかれなくに月を見る哉",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "山かつの身はしもなから衣打音に哀やきこえあくらん",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "霧はるゝゐなのをゆけはむこか崎月をそ見つる宿はなくして",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "さひしさの音をしるへの里遠み人もとへとや衣うつらん",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "しるへする月ゆへ今もわすれぬは西といふかたや昔なるらん",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "むへしこそ松は紅葉にのこりけれ同しえをたにわきて染れは",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "秋風にふはのせきやの荒まくもおしからぬまて月そもりける",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "泉河はゝその梢見わたせはわたりを遠み紅葉しにけり",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "をしほ山おのへの松の秋風に神よもふりてすめる月かけ",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "またちらぬあさの盛のもみちはにたかゝね〓との木枯の里",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "道のへのかはをとはやみ寒きよにせまくしみえてすめる月影",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "はれくもりしくるゝ數はしらねともぬれて千入の秋の紅葉は",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "いつまてか月にも見えん世中にまた在明のほともはかなし",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "ことに今ふる里寒き長月のかつらのもみち秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "きりかくれうたふ舟人聲はかりするかの海の沖にてにけり",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "しら玉のをすての山の秋の露つらぬくゝさも今や枯なん",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "庭草のもとくたちゆくさかりなるやゝ過るねに虫の鳴也",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "ひを經ては秋風寒み棹鹿のたちのゝまゆみ紅葉しにけり",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "けふかへる秋の道しはいかならん庭の淺ちの色を見るにも",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "冬の夜のしくるゝ空の雲たえすさすらひいてゝすめる月かな",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "冬きぬといふはかりにや神無月けさは時雨のふりまさりつゝ",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "吹あるゝ霜よの風は寒けれと身にかへてこそ月をなかむれ",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "道たえていくかになりぬうは氷とつなのはしはくる人もなし",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "はやすくる時雨やなにそ神無月はるゝを見るも冬はきにけり",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "いかなれはをしのうきねのたえぬらん氷も水の上ならぬかは",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "冬のくるあか月かたの一しくれ哀袖こそぬれまさるなれ",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "神なびのいは瀬の杜の冬枯にみむろの山は雪降にけり",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "けふしこそ時雨もことにふりまされ思しことそ冬の初は",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "都まて寒さそ見ゆる峯こしの比良の遠山雪降にけり",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "きつゝ又過行冬と見ゆるかなしくれてとまる雲のなけれは",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "ざえ〓〓てゆふたつ雲に白雪のかきたれふれは風はゐにけり",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "ふゆ山のしくれは又もしくれなん音たゆるまて降木のは哉",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "下折の音のみ杉のしるしにて雪のそこなるみわの山もと",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "さらてたにねさめかちなる長夜に時雨を冬とおもはすもかな",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "山かつのいそくあさ戶も明わひぬむかひの岡の雪のふゝきに",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "菅の根もうつろひかはる冬の日に夕霜いそく山の下草",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "わくらはのみちもやいとゝ絕ぬらんとはれぬ浦につもる白雪",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "須磨の油に秋をとゝめぬ關守ものこる霜夜の月はみるらん",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "田子の墨の宿まてうつむふしの根の雪もひとつに見ゆる冬哉",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "嵐ふく峯の梢の冬枯にはやまもしらぬ月のころかな",
   "kana": "",
   "speaker": "",
   "page": 138,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "窓あくるあかりやいつく軒はまてつもりふたかる庭の雪かな",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "同しくはこえてくたけよ岩の浪さのみやねたくよせて歸らん",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "きぬ〓〓をしたひもゆかて哀わか心おくれのあか月そ憂",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "玉もかるうらはの千鳥しは鳴て人のゆきゝのよは更にけり",
   "kana": "",
   "speaker": "(マこ",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "此暮らまたみたれなはあや杉のめみをはにくゝや人の思はん",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "見しや夢行衞もしらすはては又あふにかきらぬ戀の道哉",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "みなといる沖つしほかせ寒きよにかはしまかくれ千とり鳴え",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "いける身の爲社うけれそれをたにかゝつ方とて戀やしなまし",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "鹽風にわたるや遠き明石かたと中の千鳥聲しきるく",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "秋風のふくゐのむしろ寒きよに心つくしのいもをまつ哉",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "霜さゆるつゝみのうへのかはむかひをち方きけは千鳥啼え",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "柚山にたつきふかみてつくるてふいたくも戀の苦しきやなそ",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "なかめつゝわかよ更ゆく月たにもあり明過てくるゝ年哉",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "立わたるきりのした行山川のたきつ音にも袖はぬれけり",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "墨吉のきしもせくとや小夜千鳥永井のかたへ浦つたひ行",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "こえぬまを關もる神にうれへても手向そたえぬ逢坂の山",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "梓弓よはまてとをすふせ竹のはなれかたくもちきる中哉",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "なみこしのゝ坂の浦の舟よそひ人を見しよに戀やわたらん",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "ひとめもる袖をはいはす思ふ事心にためぬわか淚かな",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "末の松あたし心の夕鹽にわかみをうしと波そこえぬる",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "逢事のかたきをやくとかはらやにくるしや煙たゆるよもなき",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "つらくとも終にいもせの中ならは吉野の瀧のおちはあはきし",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "戀しなはつゐにつらさのはてそとも誰かは夢を思ひあはせん",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "枕より袖より戀の色に出てしのふところもなき淚かな",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "さりとてもふちにもあらぬさ莚に身をなけふして物思ふ哉",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "下もえのけふりや雲とうきぬらんたつ名もあたに人のとふ迄",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "さらて又おもひありとやしくるらん室のやしまのうき雲の空",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "曉のうきは別になりはてゝおもひいつるも人そ戀しき",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "こぬ人のつらさをたにもあらはさて枕のみしる小夜や更なん",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "草わかきのへもる人に物まうすわれそのそこに妻やこもれる",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "つらかりしたゝそのまゝの別より又もいとはぬあか月の鐘",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "見すいはしたゝよそならんと思へともむかへは落るわか淚哉",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "あはさりし戀にやかれてならひけん後のつらさにいける心は",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "われは戀人はわするゝとし月をおなしつもりと思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "きぬ〓〓の袂にわけし月かけはたか涙にかやとりはつらん",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "東路のふしのしは山しはしたにけたぬ思ひに立けふりかな",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "あひ見しはさなから後のつらさにてわかれや戀の初なりけん",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "なをさりに一度ちきる爲もなかき恨の夕暮の空",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "くれにともいはぬ別の曉をつれなくいてし旅の空かな",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "しかすかにたえぬ物からあはぬよのつもりそなかき契えける",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "謂千載家長朝臣人々に歌よませ侍しに月によするこひ",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "いかにせん人めもいとゝもる山に下のしくれの雲のふかさを",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "いつまてとしらぬかたみの月かけをやとす淚に袖やくちなん",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "ふしの山それも思ひのはては猶ゆく方ありて立烟哉",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "藻刈舟さしてなきさによる浪のたつ名くるしき戀もする哉",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "我戀にやみねのつはき思ひかねときはなからや色に出らん",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "戀ゆへもかひなき老のわか命あふてふことにかへはをよはし",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "稀ならんことをやかれて契りけんたゝにもたのむ心なかきは",
   "kana": "",
   "speaker": "",
   "page": 139,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "湊舟われいたつらにすてられてわけし芦まもえやはかよはん",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "またはよも羽をならふる鳥もあらし上見ぬ鷲のそらの通ち",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "さしも社あはする糸のうはよりのすきて思ひのきれにける哉",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "あともなきむかし語の古都のこるなにはゝうらさひにけり",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "つゝめとも淚は色にもりにけりさのみはなそと人のとふまて",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "老か世にまたしちたてぬ小車のつとふちからもなきそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "わかみ今猶もかしらにかみつけのいかほの沼のいかゝ悲しき",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "ふかき夜にまつ一しきり聲たてゝゆふつけ鳥は又ねしてけり",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "古川やくつるゝ岸の下はやみいとゝわたみのふかきふちかな",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "此夜はゝまた更なくに老らくのかたねふりする燈のもと",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "いはまより落あひせはき山河のくゝるもゆくも音たきるん",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "身のうれへ天つそらにはみちぬれとをよふ所のなきそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "ふりゆけは杉の緣も色つきて梢さひたる山もとの杜",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "やふかくれさてしもあふく日の光うき身もらさぬ哀ともかな",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "はすくなにふきからさるゝうら松の鹽風寒み猶たてる哉",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "かへり見ぬ雲のかけはし古のあとをはしるや數ならすとも",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "見わたせは梢ひとしきならひまつしまさき遠くたれかうへ劔",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "見わたせは嶺あらはなるふしの山高くや雲のかゝりかぬらん",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "床の上に手枕はかりかたかけてしはしと思へはねそ過にける",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "さしなから櫻やま吹つゝけともふちはあまたもなきかさし哉",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "七十にをよひかゝれる杖なれはすかりてのみそ足も立ける",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "しほかせにえやはむかはぬ枝も葉もそむきにたてる浦の松原",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "九重のきたのゝはるはかすめとも君にへたてのなきまもり哉",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "露にぬれ風もさむしとかこてとも猶うらめしくかさぬ宿かな",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "月のきるみかさとやいはん春日山おほろに見ゆる春の霞を",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "みなしこになりてや誰も迷はましはくゝむ佛世にしいてすは",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "すへらきの七よのみよにあへる身はさこそ重ねて老と成らめ",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "ふる里をおもふあまりのあしこしにいとゝ程ふる旅の悲しさ",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "なからなる橋もとてらもつくるえおこさぬ家を何にたとへん",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "我身今よものつかさをよそに見てえならす物を思ふくるしさ",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "わかの浦にそれと計のも層にてかきよする名のなきそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "家をゝしみ子を思にそ出かての道をやみともまつまよふらん",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "數ならて思ふ心にみちもなしたかなさけにかみをうれへまし",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "流石我身に生ぬへきあらましのなけきそいたく悲しかりける",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "霜雪の色にゆつりて高砂のまつもわれをはともとやはせむ",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "くもれとや老の淚にちきりけんむかしより見る秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "なき數にいまゝてもるゝ老の身の又くはゝらん程のかなしさ",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "難波江に又たてとなき澪標なとかさのみは朽はてにけり",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "をのかとちさてのみ年は武隈に松の二木のくちやはてなん",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "とてもすきかくても過る身のうさの爲こそやすき此世えけれ",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "あはれいついかにぬるまの枕とて夢も限のみえむとすらん",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "さらてたにすむ程せはき山のゐにむれてや影のしつみはて南",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "そまいたにとる所なきかたおちのくつなるものは我身えけり",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "道とをみ思しよりも日はくれて更行宿はかす人もなし",
   "kana": "",
   "speaker": ":",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "月にのみあかぬ心のなれ〓〓てかきからみなんあとの悲しさ",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "198",
   "text": "駒なつむすかのあら野の道遠みゆくさきしらてひをや暮さん",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "199",
   "text": "續拾遺前藤大納言家五十首にあか月かすかなるとり",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "200",
   "text": "しほ風にとまのうはふきひま見えて浮ねの枕明ぬ此夜は",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "201",
   "text": "きゝわかぬゆふつけ島の聲よりも老のねさめそ時はさたむる",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "202",
   "text": "津の國のあしのまろやのまろ柱すみもならはぬ旅の悲しさ",
   "kana": "",
   "speaker": "",
   "page": 140,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "203",
   "text": "またしらぬぼらのゝ末の夕附日しはしな尊そ虚きすまて",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "204",
   "text": "やみのうちもけふを限のそらにしも秋の中はゝかきおしつゝ",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "205",
   "text": "きかきりは嵐のかせも身にそひぬ今はすみかの秋の山本",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "206",
   "text": "いとゝ又雲井のたつのわか齡君か八千代にとりやそふらん",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "207",
   "text": "つれ〓〓と山への庵にくらす日の木のした闇は露のみそふる",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "208",
   "text": "百羽かきはねかくしきも音過てあした夕はわれそ侘しき",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "209",
   "text": "老らくの猶なからへてありぬやといさ心みに身をもいとはし",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "210",
   "text": "里とをく鹽やく浦は見えねともけふりにかへる興津しら浪",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "211",
   "text": "まつならて又世をひさにふる物は老その森の歎なりけり",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "212",
   "text": "山たかみふもとめくりのとを海にひとかたならぬ沖のつり舟",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "213",
   "text": "みまするのゆきあひの洲崎しほみては入江へたてぬ興津白浪",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "214",
   "text": "わか身よに足もやすめすならひきて道ゆきつかれ今そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "215",
   "text": "なをさりの野中のかこひかたあれてさすとしもなき草の門哉",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "216",
   "text": "さやかなる月みる事のみにおはてわかあたら夜の空そふけ行",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "217",
   "text": "庭もせにのとがなる草もある物をうへしなからの松の一本",
   "kana": "",
   "speaker": "",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "218",
   "text": "すてやらぬ影はつかしき古鏡さもそおもてのつれなかりける",
   "kana": "",
   "speaker": "左中將爲村",
   "page": 141,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
